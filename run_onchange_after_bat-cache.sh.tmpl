#!/bin/sh
# O bat só enxerga um tema novo depois de montar o cache. Sem isso, na
# instalação nova o --theme=noctalia cai no tema padrão.
# Roda de novo quando o tema da fonte muda: {{ include "dot_config/bat/themes/create_noctalia.tmTheme" | sha256sum }}
command -v bat >/dev/null 2>&1 && bat cache --build >/dev/null
exit 0
