# --- Histórico ---
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE

# --- Opções ---
setopt AUTO_CD INTERACTIVE_COMMENTS
bindkey -e

# --- PATH: programas do usuário e do go install ---
# Na sessão gráfica o uwsm já define isso (~/.config/uwsm/env); aqui cobre tty e ssh.
# typeset -U faz o array "path" (ligado ao PATH) ignorar entradas repetidas.
typeset -U path
path=("$HOME/.local/bin" "$HOME/go/bin" $path)
export EDITOR=nvim
export VISUAL=nvim

# --- Completação ---
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'   # ignora maiúsculas/minúsculas
eval "$(dircolors -b)"                                     # define LS_COLORS (cores por tipo de arquivo)
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:descriptions' format '[%d]'         # nomeia os grupos (o fzf-tab usa)
zstyle ':completion:*:git-checkout:*' sort false          # branches na ordem do git
zstyle ':completion:*' menu no                            # o menu agora é o fzf-tab

# --- fzf-tab: o Tab abre as opções no fzf (busca difusa + prévia) ---
# Precisa vir depois do compinit e antes do autosuggestions/syntax-highlighting.
source /usr/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh
zstyle ':fzf-tab:*' use-fzf-default-opts yes              # usa as cores Catppuccin do FZF_DEFAULT_OPTS
zstyle ':fzf-tab:*' switch-group '<' '>'                  # < e > trocam de grupo
zstyle ':fzf-tab:complete:(cd|z|__zoxide_z):*' fzf-preview 'eza -1 --color=always --icons=always $realpath'
# dentro do tmux, abre num popup flutuante em vez de ocupar o pane
[[ -n $TMUX ]] && zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup

# --- Ferramentas ---
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
source <(fzf --zsh)
command -v mise >/dev/null && eval "$(mise activate zsh)"   # seção 10.2

# --- fzf: fd e Catppuccin Mocha ---
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
--color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"

# --- bat ---
export BAT_THEME="Catppuccin Mocha"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# --- Aliases ---
alias ls='eza --icons=auto --group-directories-first'
alias ll='eza -l --icons=auto --git --group-directories-first'
alias la='eza -la --icons=auto --git --group-directories-first'
alias tree='eza --tree --icons=auto'
alias cat='bat --paging=never'
alias v='nvim'

# --- Plugins (o syntax-highlighting por último) ---
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
