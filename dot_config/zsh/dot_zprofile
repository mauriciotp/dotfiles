# Abre o Hyprland ao fazer login no tty1, pelo uwsm (sessão gerenciada pelo systemd).
# O ambiente da sessão fica em ~/.config/uwsm/env (e env-hyprland).
# Se o uwsm não puder iniciar, cai no start-hyprland como reserva.
# Socorro: se a sessão não abrir, entre no tty2 (Ctrl+Alt+F2) e veja
#   journalctl --user -b -u 'wayland-wm*'
if [ -z "$WAYLAND_DISPLAY" ] && [ "$XDG_VTNR" -eq 1 ]; then
  if uwsm check may-start; then
    exec uwsm start hyprland.desktop
  fi
  exec start-hyprland
fi
