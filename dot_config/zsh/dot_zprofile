# Abre o Hyprland ao fazer login no tty1, pelo uwsm (sessão gerenciada pelo systemd).
# O ambiente da sessão fica em ~/.config/uwsm/env (e env-hyprland).
# Sem o uwsm instalado, abre pelo start-hyprland. Com ele, se o "may-start"
# recusar (sessão gráfica já aberta, graphical.target não chegou), fica no
# shell: subir o Hyprland mesmo assim abriria uma segunda sessão (README do
# uwsm, Shell profile integration). Para abrir à mão: uwsm start hyprland.desktop
# Socorro: se a sessão não abrir, entre no tty2 (Ctrl+Alt+F2) e veja
#   journalctl --user -b -u 'wayland-wm*'
# ${XDG_VTNR:-0}: no ssh a variável não existe, e o -eq daria erro.
if [ -z "$WAYLAND_DISPLAY" ] && [ "${XDG_VTNR:-0}" -eq 1 ]; then
  if command -v uwsm >/dev/null; then
    uwsm check may-start && exec uwsm start hyprland.desktop
  else
    exec start-hyprland
  fi
fi
