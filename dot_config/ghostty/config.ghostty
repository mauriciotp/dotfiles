# Tema e fonte
theme = noctalia
font-family = JetBrainsMono Nerd Font
font-size = 12

# Janela: sem barra de título (o Hyprland desenha a borda)
window-decoration = none
window-padding-x = 8
window-padding-y = 6

# Comportamento
cursor-style = block
cursor-style-blink = false
# no-cursor: deixa o cursor em bloco mesmo no prompt (o zsh não troca para barra)
# ssh-env: no ssh, usa TERM=xterm-256color e repassa COLORTERM etc. (evita "unknown terminal")
# (o Shift+Enter do Claude Code já funciona no Ghostty sem keybind: ele fala o protocolo do kitty)
shell-integration-features = no-cursor,ssh-env
confirm-close-surface = false
copy-on-select = clipboard
# sem o aviso de tamanho ao redimensionar (o tiling redimensiona o tempo todo)
resize-overlay = never
