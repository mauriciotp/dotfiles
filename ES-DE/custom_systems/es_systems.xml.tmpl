<?xml version="1.0"?>
<!-- Sistemas do ES-DE que complementam os do pacote
     (/usr/share/es-de/resources/systems/linux/es_systems.xml).
     Doc: INSTALL.md do ES-DE, seção es_systems.xml.
     Os jogos ficam em ~/Games/Emulators/<Plataforma>/ROMs. Um sistema com o
     mesmo <name> de um do pacote o substitui. -->
<systemList>
    <!-- Switch 2: não existe no ES-DE 3.5. Plataforma e tema do Switch.
         O comando segue o do Eden no pacote (-f tela cheia, -g abre o jogo). -->
    <system>
        <name>switch2</name>
        <fullname>Nintendo Switch 2</fullname>
        <path>~/Games/Emulators/Switch2/ROMs</path>
        <extension>.nup .NUP</extension>
        <command label="Lichii (Standalone)">%PRECOMMAND_GAME-RUN% %EMULATOR_LICHII% -f -g %ROM%</command>
        <platform>switch</platform>
        <theme>switch</theme>
    </system>
</systemList>
