# Abrir pastas (xdg-open, "abrir pasta" dos apps) no yazi dentro do Ghostty.
# O yazi.desktop do pacote tem Terminal=true, e o xdg-open fora de um terminal
# o roda sem terminal: o yazi falha e nada aparece. Padrão para inode/directory
# em run_onchange_after_mime-defaults.sh. Fora do menu: SUPER+SHIFT+F abre o yazi.
# env -u: um jogo aberto pelo game-run (Lichii, Hookshot) passa o MangoHud no
# LD_PRELOAD para o que ele abrir, e o Ghostty trava com ele (100% de CPU, sem janela).
[Desktop Entry]
Type=Application
Name=Yazi (Ghostty)
Comment=Open a folder in yazi inside Ghostty
Icon=yazi
Exec=env -u LD_PRELOAD -u MANGOHUD ghostty -e yazi %f
MimeType=inode/directory;
NoDisplay=true
Terminal=false
