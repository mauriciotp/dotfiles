#!/bin/bash
# Cola de atalhos do Hyprland (SUPER+F1). Lista os atalhos que têm descrição
# (flag description no binds.lua) num fzf para buscar.
# Uso: keybinds          → lista no terminal atual
#      keybinds --window → abre numa janela flutuante do Ghostty
set -euo pipefail

if [[ ${1:-} == --window ]]; then
    exec ghostty --class=com.mauricio.keybinds --title="Atalhos" -e "$0"
fi

# modmask é uma máscara de bits: SHIFT=1 CAPS=2 CTRL=4 ALT=8 SUPER=64
hyprctl binds -j | jq -r '
    def mods($m): [
        (if ($m % 128) >= 64 then "SUPER" else empty end),
        (if ($m % 8)   >= 4  then "CTRL"  else empty end),
        (if ($m % 16)  >= 8  then "ALT"   else empty end),
        (if ($m % 2)   >= 1  then "SHIFT" else empty end)
    ];
    .[] | select(.has_description)
        | ((mods(.modmask) + [.key]) | join(" + ")) as $k
        | "\($k)\t\(.description)"' |
    column -t -s $'\t' |
    fzf --reverse --no-sort --prompt="atalho › " --header="Esc fecha" \
        --color=bg+:#313244,bg:#1e1e2e,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc,prompt:#cba6f7,hl+:#f38ba8 \
    >/dev/null || true
