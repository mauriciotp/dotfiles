#!/bin/bash
# Cola de atalhos do Hyprland (SUPER+F1). Lista os atalhos que têm descrição
# (flag description nos arquivos de ~/.config/hypr/binds/) num fzf para buscar.
# Uso: keybinds          → lista no terminal atual
#      keybinds --window → abre numa janela flutuante do Ghostty
set -euo pipefail

if [[ ${1:-} == --window ]]; then
    exec ghostty --class=com.mauricio.keybinds --title="Keybinds" -e "$0"
fi

# cores do Noctalia: aberto pelo Hyprland, o script não herda o FZF_DEFAULT_OPTS do zsh
theme="${XDG_CONFIG_HOME:-$HOME/.config}/fzf/themes/noctalia.sh"
[[ -r $theme ]] && source "$theme"

# modmask é uma máscara de bits: SHIFT=1 CAPS=2 CTRL=4 ALT=8 SUPER=64
hyprctl binds -j | jq -r '
    def mods($m): [
        (if ($m % 128) >= 64 then "SUPER" else empty end),
        (if ($m % 8)   >= 4  then "CTRL"  else empty end),
        (if ($m % 16)  >= 8  then "ALT"   else empty end),
        (if ($m % 2)   >= 1  then "SHIFT" else empty end)
    ];
    .[] | select(.has_description)
        | ((mods(.modmask) + [.key]) | join(" + ")) as $k
        | "\($k)\t\(.description)"' |
    column -t -s $'\t' |
    fzf --reverse --no-sort --prompt="keybind › " --header="Esc closes" >/dev/null || true
