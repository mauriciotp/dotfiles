#!/bin/bash
# Toggles do Hyprland (Omarchy, omarchy-hyprland-toggle).
# O estado fica em ~/.local/state/hypr/ e o hyprland/toggles.lua o carrega a
# cada reload, então o efeito sobrevive ao SUPER+CTRL+R e ao tv-toggle.
# Uso: hypr-toggle                         menu (fzf): Enter liga/desliga
#      hypr-toggle --window                o menu numa janela flutuante do Ghostty (SUPER+CTRL+T)
#      hypr-toggle <nome> [on|off|toggle]  um toggle (hyprland/toggles/<nome>.lua)
#      hypr-toggle list                    estado de todos
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
state="${XDG_STATE_HOME:-$HOME/.local/state}/hypr"
toggles_dir="$config/hyprland/toggles"

if [[ ${1:-} == --window ]]; then
    exec ghostty --class=com.mauricio.float --title="Toggles" -e "$0"
fi

# primeira linha de comentário do arquivo, sem o "-- "
describe() { sed -n '1s/^-- *//p' "$1"; }

names() { find "$toggles_dir" -maxdepth 1 -name '*.lua' -printf '%f\n' 2>/dev/null | sed 's/\.lua$//' | sort; }

is_on() { [[ -f $state/toggles/$1 ]]; }

set_toggle() {
    local name=$1 action=${2:-toggle}
    [[ -f $toggles_dir/$name.lua ]] || { echo "toggle desconhecido: $name (veja: hypr-toggle list)" >&2; exit 1; }
    if [[ $action == toggle ]]; then
        is_on "$name" && action=off || action=on
    fi
    case $action in
        on) mkdir -p "$state/toggles" && : >"$state/toggles/$name" ;;
        off) rm -f "$state/toggles/$name" ;;
        *) echo "ação inválida: $action (on, off ou toggle)" >&2; exit 1 ;;
    esac
    hyprctl reload >/dev/null
    command -v notify-send >/dev/null && notify-send -a Hyprland -t 2500 "$name: $action" || true
}

# uma linha por toggle: nome, marca e descrição, separados por tab
items() {
    local name
    for name in $(names); do
        printf '%s\t%s\t%s\n' "$name" "$(is_on "$name" && echo '[x]' || echo '[ ]')" "$(describe "$toggles_dir/$name.lua")"
    done
}

menu() {
    # cores do Noctalia: aberto pelo Hyprland, o script não herda o FZF_DEFAULT_OPTS do zsh
    local theme="${XDG_CONFIG_HOME:-$HOME/.config}/fzf/themes/noctalia.sh"
    # shellcheck source=/dev/null
    [[ -r $theme ]] && source "$theme"
    local line
    # depois de cada escolha o menu volta, com o estado novo; Esc sai
    while line=$(items | fzf --reverse --exact --ignore-case --delimiter='\t' --with-nth=2,1,3 \
        --prompt="toggle › " --header="Enter: liga/desliga · Esc: sai"); do
        set_toggle "$(cut -f1 <<<"$line")"
    done
}

case ${1:-} in
    "") menu ;;
    list) items | cut -f1-2 | column -t -s $'\t' ;;
    -h | --help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) set_toggle "$1" "${2:-toggle}" ;;
esac
