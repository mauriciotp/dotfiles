#!/bin/bash
# Instala a versão mais recente do GE-Proton na Steam, se ainda não estiver lá.
# Uso: update-ge-proton   (depois, reinicie a Steam e escolha a versão nova
#                          nas propriedades do jogo, em Compatibilidade)
#
# O GE-Proton é o Proton com o driver Wayland do Wine, que o script hdr usa
# para o HDR sem gamescope. Baixa o x86_64 da última release no GitHub, confere
# o sha512 publicado junto e extrai em ~/.steam/steam/compatibilitytools.d.
# As versões antigas ficam: apague a pasta à mão quando não precisar mais.
set -euo pipefail

steam_dir=~/.steam/steam
tools_dir="$steam_dir/compatibilitytools.d"
[[ -d $steam_dir ]] || { echo "Open Steam once first." >&2; exit 1; }
mkdir -p "$tools_dir"

# Última release: nome do tarball x86_64 e do checksum dele
release_json=$(curl -fsS --max-time 10 \
    https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest) ||
    { echo "Failed to query GitHub." >&2; exit 1; }

tarball_url=$(jq -r '[.assets[].browser_download_url | select(endswith("-x86_64.tar.gz"))][0] // empty' <<<"$release_json")
[[ -n $tarball_url ]] || { echo "x86_64 tarball not found." >&2; exit 1; }

tarball_name=$(basename "$tarball_url")
release_name=${tarball_name%.tar.gz} # também é o nome da pasta extraída
checksum_url=$(jq -r --arg f "$release_name.sha512sum" \
    '[.assets[] | select(.name == $f) | .browser_download_url][0] // empty' <<<"$release_json")
[[ -n $checksum_url ]] || { echo "Checksum not found." >&2; exit 1; }

if [[ -d $tools_dir/$release_name ]]; then
    echo "$release_name is already installed."
    exit 0
fi

# Baixar, conferir e extrair
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cd "$tmp"
echo "Downloading $release_name..."
curl -fL "$tarball_url" -o "$tarball_name" --progress-bar
curl -fsSL "$checksum_url" | sha512sum -c -
tar -xf "$tarball_name" -C "$tools_dir"
echo "Installed: $release_name. Restart Steam."
