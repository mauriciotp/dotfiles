#!/bin/bash
# Modo console: a Steam no Big Picture dentro do gamescope, como no Steam Deck.
# O overlay da Steam vira uma camada do gamescope, em vez de ser desenhado
# dentro do jogo a cada quadro (lento em 4K). Atalho: SUPER+CTRL+SHIFT+G.
#
# 1. liga a TV, se conectada (tv-toggle); sem ela, usa o monitor do workspace 10.
#    Com --monitor (SUPER+CTRL+SHIFT+ALT+G), não liga a TV e, se ela estiver
#    ligada, desliga: para jogar no monitor enquanto alguém usa os apps da TV
# 2. fecha a Steam do desktop: só pode haver uma Steam
# 3. abre o gamescope com o modo do monitor do workspace 10 (ArchWiki: sem
#    -W/-H/-r ele pode abrir na resolução errada)
# 4. quando a Steam fecha, reabre a Steam do desktop em segundo plano e, se foi
#    o script que ligou a TV, desliga de novo (os jogos voltam a abrir no monitor)
#
# Para sair, o mesmo atalho de novo. O Switch to Desktop do Big Picture não
# funciona fora do SteamOS: ele chama o SteamOS Manager pelo D-Bus
# (com.steampowered.SteamOSManager1), que não existe no Arch, e fica carregando.
set -euo pipefail

TV="HDMI-A-1"
GAMES=10
on_monitor=false
[[ ${1:-} == --monitor ]] && on_monitor=true

# Já no modo console: fecha a Steam de dentro; o gamescope sai junto
if pgrep -f '^gamescope .*-- steam -tenfoot' >/dev/null; then
    exec steam -shutdown
fi

monitors() { hyprctl monitors -j; }
tv_active() { monitors | jq -e --arg tv "$TV" 'any(.[]; .name == $tv)' >/dev/null; }

# A TV em espera continua conectada (aparece em "monitors all"); ativa só depois do tv-toggle
turned_tv_on=false
if $on_monitor; then
    if tv_active; then "$HOME/.local/bin/tv-toggle" off; fi
elif hyprctl monitors all -j | jq -e --arg tv "$TV" 'any(.[]; .name == $tv)' >/dev/null && ! tv_active; then
    "$HOME/.local/bin/tv-toggle" on
    turned_tv_on=true
fi
hyprctl dispatch "hl.dsp.focus({ workspace = $GAMES })" >/dev/null

# Modo do monitor que está com o workspace 10 (pixels reais, sem a escala)
output=$(hyprctl workspaces -j | jq -r --argjson id "$GAMES" '.[] | select(.id == $id) | .monitor')
read -r width height refresh < <(monitors | jq -r --arg m "$output" \
    '.[] | select(.name == $m) | "\(.width) \(.height) \(.refreshRate | round)"')
if [[ -z ${width:-} ]]; then
    echo "Monitor of workspace $GAMES not found." >&2
    exit 1
fi

if pgrep -x steam >/dev/null; then
    steam -shutdown >/dev/null 2>&1 || true
    for _ in $(seq 60); do
        pgrep -x steam >/dev/null || break
        sleep 0.5
    done
    if pgrep -x steam >/dev/null; then
        echo "Steam did not close." >&2
        exit 1
    fi
fi

# Limite de FPS: 3 abaixo da taxa da tela, dentro do VRR (como o fps_limit do
# MangoHud.conf, que não vale aqui dentro). O -r é a taxa da tela virtual do
# jogo; o --framerate-limit só divide a taxa (144 / 141 daria 144).
fps=$((refresh - 3))

# HUD: sem -steamdeck a Steam não escolhe preset, e o gamescope criaria um
# arquivo só com no_display. Com o MANGOHUD_CONFIGFILE definido, o gamescope
# usa o arquivo dado; vai uma cópia do MangoHud.conf, para a Steam nunca
# sobrescrever o original (gist do Steam Gamescope Session, comentário 1).
hud="${XDG_RUNTIME_DIR:-/tmp}/steam-console-mangohud.conf"
if cp "$HOME/.config/MangoHud/MangoHud.conf" "$hud" 2>/dev/null; then
    export MANGOHUD_CONFIGFILE="$hud"
fi

# -e: integração com a Steam (overlay em camada; evita a "lag bomb", ArchWiki)
# -f: tela cheia pela flag (o atalho de tela cheia deixa lento, ArchWiki)
# --mangoapp: o MangoHud do gamescope (o mangohud normal não funciona aqui)
gamescope -e -f --adaptive-sync --mangoapp \
    -W "$width" -H "$height" -r "$fps" -- steam -tenfoot || true

# De volta ao desktop: a TV como estava e a Steam normal em segundo plano (workspace 8)
if $turned_tv_on && tv_active; then
    "$HOME/.local/bin/tv-toggle" off
fi
if command -v uwsm >/dev/null && uwsm check is-active >/dev/null 2>&1; then
    exec uwsm app -- steam -silent
fi
exec steam -silent
