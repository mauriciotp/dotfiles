#!/bin/bash
# Roda um jogo dentro do gamescope, no modo da tela em foco; na TV, com HDR.
# Para quando um jogo só funciona bem no gamescope, ou para HDR com um Proton
# da Valve (que não tem Wayland).
#
# Uso:
#   gs-run [opções] gamemoderun %command%   opção de inicialização da Steam
#   gs-run [opções] ./jogo                  terminal; no Heroic, no campo do wrapper
# Opções (na TV o HDR já vem ligado; no monitor, desligado):
#   --hdr          oferece HDR ao jogo (--hdr-enabled); o jogo liga no menu dele
#   --sdr          sem HDR, mesmo que o jogo peça
#   --itm          HDR "falso" para jogos SDR (--hdr-itm-enabled)
#   --sdr-nits N   brilho do conteúdo SDR dentro do HDR (padrão do gamescope: 400)
#   --dry-run      só mostra o que rodaria
#
# Resolução e taxa da tela em foco, com o limite 3 abaixo da taxa (dentro do
# VRR), como o steam-bigpicture. Com HDR e um Proton da Valve, acrescenta
# DXVK_HDR=1 (ArchWiki HDR); o GE-Proton detecta sozinho e não precisa
# (README do GE-Proton). Dentro do gamescope, o Wine usa o XWayland dele, sem
# PROTON_ENABLE_WAYLAND.
set -euo pipefail

TV="HDMI-A-1"

hdr=auto
itm=false
sdr_nits=""
dry=false
while (($#)); do
    case $1 in
        --hdr) hdr=on ;;
        --sdr) hdr=off ;;
        --itm) itm=true ;;
        --sdr-nits)
            [[ ${2:-} =~ ^[0-9]+$ ]] || { echo "--sdr-nits needs a number" >&2; exit 1; }
            sdr_nits=$2
            shift
            ;;
        --dry-run) dry=true ;;
        --) shift; break ;;
        *) break ;;
    esac
    shift
done
if (($# == 0)); then
    echo "Usage: gs-run [--hdr|--sdr] [--itm] [--sdr-nits N] [--dry-run] <command>" >&2
    exit 1
fi

read -r screen width height refresh < <(hyprctl monitors -j |
    jq -r '.[] | select(.focused) | "\(.name) \(.width) \(.height) \(.refreshRate | round)"')
if [[ -z ${width:-} ]]; then
    echo "Focused monitor not found." >&2
    exit 1
fi
fps=$((refresh - 3))

flags=(-f -W "$width" -H "$height" -r "$fps")
vars=()
if [[ $hdr == on || ($hdr == auto && $screen == "$TV") ]]; then
    flags+=(--hdr-enabled)
    if $itm; then flags+=(--hdr-itm-enabled); fi
    if [[ -n $sdr_nits ]]; then flags+=(--hdr-sdr-content-nits "$sdr_nits"); fi
    if [[ " $* " == *"/steamapps/common/Proton"* ]]; then
        vars=(DXVK_HDR=1)
    fi
fi

if $dry; then
    echo "screen: $screen"
    echo "env ${vars[*]} gamescope ${flags[*]} -- $*"
    exit 0
fi
exec env "${vars[@]}" gamescope "${flags[@]}" -- "$@"
